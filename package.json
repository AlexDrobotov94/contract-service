{
  "name": "my-turborepo",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:types": "ts-node tooling/generate-types.ts",
    "build": "turbo run build",
    "dev": "npm run generate:types && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.13",
    "typescript": "5.9.2",
    "json-schema-to-typescript": "^15.0.0",
    "ts-node": "^10.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
